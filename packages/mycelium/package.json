{
  "name": "@oakgreencc/mycelium",
  "version": "0.0.17",
  "description": "Intake connectors, run as a launchd agent: Discord posts, App Store / Google Play reviews and in-app bug reports become deduplicated q:intake intent issues on GitHub.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oakgreencc/monorepo.git",
    "directory": "packages/mycelium"
  },
  "homepage": "https://github.com/oakgreencc/monorepo/tree/main/packages/mycelium#readme",
  "bugs": {
    "url": "https://github.com/oakgreencc/monorepo/issues"
  },
  "keywords": [
    "intake",
    "github",
    "discord",
    "app-store-connect",
    "google-play",
    "reviews"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./broker": "./src/broker.mjs",
    "./envfile": "./src/envfile.mjs",
    "./package.json": "./package.json",
    "./forest": "./src/forest.mjs"
  },
  "bin": {
    "mycelium": "bin/mycelium.mjs"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "lint": "biome check .",
    "test": "node --test 'test/*.test.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "name": "mycelium"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1"
  }
}
