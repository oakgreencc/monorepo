{
  "name": "@oakgreencc/cambium",
  "version": "0.0.52",
  "description": "The scheduler daemon: reads the q:* queues from GitHub every tick, runs headless claude workers in their own worktrees up to a cap, and makes every queue transition itself.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oakgreencc/monorepo.git",
    "directory": "packages/cambium"
  },
  "homepage": "https://github.com/oakgreencc/monorepo/tree/main/packages/cambium#readme",
  "bugs": {
    "url": "https://github.com/oakgreencc/monorepo/issues"
  },
  "keywords": [
    "github",
    "scheduler",
    "agent",
    "claude-code",
    "queue",
    "launchd"
  ],
  "bin": {
    "cambium": "bin/cambium.mjs"
  },
  "exports": {
    "./graph": "./src/graph/index.mjs",
    "./graph/langgraph": "./src/graph/langgraph.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "otel/",
    "src/"
  ],
  "scripts": {
    "lint": "biome check .",
    "test": "node --test 'test/*.test.mjs'"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "name": "cambium"
  },
  "dependencies": {
    "@oakgreencc/mycelium": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.5"
  },
  "peerDependencies": {
    "@langchain/langgraph": "^1.7.5"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    }
  }
}
